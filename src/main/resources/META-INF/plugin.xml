<idea-plugin>
    <id>com.github.flobilosaurus.branchchanges</id>
    <name>Branch Changes</name>
    <vendor url="https://github.com/flobilosaurus">flobilosaurus</vendor>

    <description><![CDATA[
        Highlights added, modified, and deleted editor lines since the fork point with an explicitly selected branch base.
        Includes committed, staged, unstaged, and unsaved changes, supports Git-detected committed/staged renames,
        and opens fork-to-live full-file diffs from gutter markers. Base mappings stay workspace-local;
        Git operations remain local, read-only, and never fetch.
    ]]></description>

    <change-notes><![CDATA[
        <p>Initial MVP: branch-specific base selection, live fork-relative markers, rename-aware baselines,
        full-file marker diff, project controls, theme-aware colors, and local-only read-only Git behavior.</p>
    ]]></change-notes>

    <idea-version since-build="243" until-build="262.*"/>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.vcs</depends>
    <depends>Git4Idea</depends>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="com.github.flobilosaurus.branchchanges.BranchChangesProjectActivity"/>
        <statusBarWidgetFactory id="BranchChanges"
                                implementation="com.github.flobilosaurus.branchchanges.ui.BranchChangesStatusBarWidgetFactory"/>
        <editorNotificationProvider implementation="com.github.flobilosaurus.branchchanges.ui.BranchBaseEditorNotificationProvider"/>
        <colorSettingsPage implementation="com.github.flobilosaurus.branchchanges.editor.BranchChangesColors"/>
    </extensions>

    <applicationListeners>
        <listener class="com.github.flobilosaurus.branchchanges.editor.BranchEditorFactoryListener"
                  topic="com.intellij.openapi.editor.event.EditorFactoryListener"/>
    </applicationListeners>

    <projectListeners>
        <listener class="com.github.flobilosaurus.branchchanges.editor.BranchFileEditorManagerListener"
                  topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
    </projectListeners>
</idea-plugin>
